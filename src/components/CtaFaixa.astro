---
import { Image } from 'astro:assets';
import fundo from '../assets/fundo.jpg';
import { site, wa } from '../data/site';
interface Props { titulo: string; mensagem?: string }
const { titulo, mensagem } = Astro.props;
---
<section class="cta bg-escuro">
  <Image src={fundo} alt="" class="bg" widths={[800, 1600]} sizes="100vw" />
  <div class="wrap conteudo reveal">
    <div>
      <p class="script">{site.slogan}</p>
      <h2 class="titulo">{titulo}</h2>
    </div>
    <a class="btn btn-ouro btn-lg" href={wa(mensagem)} target="_blank" rel="noopener">Agendar pelo WhatsApp</a>
  </div>
</section>

<style>
  .cta { position: relative; overflow: hidden; padding: 96px var(--gutter); }
  .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .35; }
  .conteudo { position: relative; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 32px; }
  .script { color: var(--cobre-claro); }
  .titulo { font-size: clamp(36px, 4.6vw, 56px); line-height: 1.04; color: var(--claro); }
</style>
