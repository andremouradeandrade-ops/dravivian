---
interface Props { itens: { q: string; a: string }[] }
const { itens } = Astro.props;
---
<div class="faq">
  {itens.map((f) => (
    <details>
      <summary>{f.q}<span class="mais" aria-hidden="true">+</span></summary>
      <div class="resposta"><div><p>{f.a}</p></div></div>
    </details>
  ))}
</div>
