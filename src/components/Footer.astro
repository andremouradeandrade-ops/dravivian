---
import { Image } from 'astro:assets';
import monograma from '../assets/monograma.png';
import IconeWhats from './IconeWhats.astro';
import { site, menu, wa } from '../data/site';
const ano = new Date().getFullYear();
---
<footer class="rodape">
  <div class="wrap grade">
    <div class="col marca reveal">
      <Image src={monograma} alt="" width={144} class="mono" />
      <p class="nome">{site.nome}</p>
      <p>{site.especialidade}</p>
    </div>
    <nav aria-label="Rodapé" class="col links reveal">
      {menu.map((m) => <a href={m.href}>{m.rotulo}</a>)}
    </nav>
    <div class="col reveal">
      <p>{site.regiao}</p>
      <a href="/privacidade">Política de privacidade</a>
      <div class="redes">
        <a href={site.instagram} target="_blank" rel="noopener" aria-label="Instagram da Dra. Vivian">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
          </svg>
        </a>
        <a href={wa()} target="_blank" rel="noopener" aria-label="WhatsApp da Dra. Vivian">
          <IconeWhats size={24} />
        </a>
      </div>
    </div>
  </div>
  <div class="wrap aviso">
    <span>Resultados variam de pessoa para pessoa. As indicações são definidas após avaliação individual.</span>
    <span>© {ano} {site.nomeCurto}</span>
  </div>
</footer>

<style>
  .rodape { background: var(--escuro-2); color: var(--claro-2); font-size: 14px; padding: 64px var(--gutter) 28px; }
  .grade { display: flex; flex-wrap: wrap; gap: 40px 72px; }
  .col { flex: 1 1 240px; display: flex; flex-direction: column; gap: 8px; }
  .marca { flex-basis: 300px; gap: 12px; }
  .mono { width: 72px; height: auto; }
  .nome { font-family: var(--serif); font-size: 26px; color: var(--claro); }
  .links { flex-basis: 180px; gap: 0; }
  a { color: #F6E6DC; text-decoration: none; padding: 6px 0; }
  a:hover { color: var(--cobre-claro); }
  .col:last-child a { text-decoration: underline; }
  .redes { display: flex; gap: 10px; margin-top: 4px; }
  .redes a { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 1px solid var(--linha-escura); border-radius: 50%; }
  .redes a:hover, .redes a:focus-visible { color: var(--cobre-claro); border-color: currentColor; }
  .aviso {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px;
    margin-top: 48px; padding-top: 20px; border-top: 1px solid #4A2619; font-size: 13px; color: #B8927F;
  }
</style>
