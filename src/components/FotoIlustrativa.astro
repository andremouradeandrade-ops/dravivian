---
import { Image } from 'astro:assets';
import type { Foto } from '../data/fotos';

interface Props {
  foto: Foto;
  altura: string;
  sizes: string;
  eager?: boolean;
}

const { foto, altura, sizes, eager = false } = Astro.props;
---
<figure style={{ height: altura }}>
  <Image
    src={foto.src}
    alt={foto.alt}
    widths={[360, 640, 900, 1200].filter((width) => width <= foto.src.width)}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
  />
  <figcaption>Imagem ilustrativa</figcaption>
</figure>

<style>
  figure { position: relative; margin: 0; overflow: hidden; background: var(--escuro-3); }
  img { width: 100%; height: 100%; object-fit: cover; }
  figcaption {
    position: absolute;
    inset: auto auto 12px 12px;
    padding: 4px 9px;
    border-radius: 6px;
    background: var(--escuro-2);
    color: var(--claro);
    font-size: 12px;
  }
</style>
