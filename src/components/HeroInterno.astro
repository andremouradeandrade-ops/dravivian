---
import { Image } from 'astro:assets';
import FotoIlustrativa from './FotoIlustrativa.astro';
import type { Foto } from '../data/fotos';
import fundo from '../assets/fundo.jpg';

interface Props {
  trilha: { href?: string; rotulo: string }[];
  sobretitulo: string;
  titulo: [string, string];
  resumo: string;
  foto: Foto;
}
const { trilha, sobretitulo, titulo, resumo, foto } = Astro.props;
---
<section class="hero bg-escuro">
  <Image src={fundo} alt="" class="bg" widths={[800, 1600]} sizes="100vw" loading="eager" />
  <div class="wrap-lg grade">
    <div class="texto">
      <nav aria-label="Você está em" class="trilha entra" style="--i:0">
        <ol>
          {trilha.map((t, i) => (
            <li>
              {t.href ? <a href={t.href}>{t.rotulo}</a> : <span aria-current="page">{t.rotulo}</span>}
              {i < trilha.length - 1 && <span aria-hidden="true" class="sep">/</span>}
            </li>
          ))}
        </ol>
      </nav>
      <p class="script entra" style="--i:1">{sobretitulo}</p>
      <h1 class="h1 entra" style="--i:2">{titulo[0]} <em>{titulo[1]}</em></h1>
      <p class="resumo entra" style="--i:3">{resumo}</p>
      <div class="entra" style="--i:4"><slot /></div>
    </div>
    <div class="arco entra" style="--i:3">
      <FotoIlustrativa foto={foto} altura="100%" sizes="(max-width: 500px) 90vw, 440px" eager />
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; padding: 150px var(--gutter) 88px; }
  .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .55; }
  .grade { position: relative; display: flex; flex-wrap: wrap; gap: 48px 72px; align-items: center; }
  .texto { flex: 1 1 560px; min-width: 0; }
  .trilha ol { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 28px; padding: 0; font-size: 14px; color: var(--claro-2); }
  .trilha li { display: flex; gap: 8px; }
  .trilha a { color: #E3C3B2; }
  .script { margin-bottom: 14px; }
  .resumo { margin-top: 26px; max-width: 580px; font-size: 19px; color: #F2DCCF; }
  .arco {
    flex: 0 1 440px; min-width: 0; height: clamp(380px, 45vw, 540px);
    border-radius: 220px 220px 24px 24px; padding: 4px; overflow: hidden;
    background: linear-gradient(180deg, #F2C3A4 0%, #A0543A 70%, #6E3420 100%);
  }
  .arco > :global(figure) { border-radius: 216px 216px 20px 20px; }
  .entra { animation: sobe .9s cubic-bezier(.2,.7,.2,1) both; animation-delay: calc(var(--i) * 110ms + 100ms); }
  @keyframes sobe { from { opacity: 0; transform: translateY(24px); } }
</style>
