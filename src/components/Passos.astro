---
interface Props { itens: { t: string; d: string; info?: string }[]; escuro?: boolean }
const { itens, escuro = false } = Astro.props;
---
<ol class:list={['passos', { escuro }]}>
  {itens.map((s, i) => (
    <li class="reveal" style={`--d:${i * 90}ms`}>
      <span class="n">{String(i + 1).padStart(2, '0')}</span>
      <span class="t">{s.t}</span>
      <span class="d">{s.d}</span>
      {s.info && <span class="info">{s.info}</span>}
    </li>
  ))}
</ol>

<style>
  .passos { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; border-top: 1px solid var(--linha); }
  .escuro { border-color: var(--linha-escura); }
  li { position: relative; flex: 1 1 240px; min-width: 0; padding: 32px 28px 8px 0; display: flex; flex-direction: column; gap: 10px; }
  li::before { content: ''; position: absolute; top: -1px; left: 0; width: 40px; height: 2px; background: var(--cobre); }
  .escuro li::before { background: var(--cobre-claro); }
  .n { font-family: var(--serif); font-size: 22px; color: var(--cobre); }
  .escuro .n { color: var(--cobre-claro); }
  .t { font-family: var(--serif); font-size: 30px; line-height: 1.1; }
  .escuro .t { color: var(--claro); }
  .d { font-size: 15px; color: var(--texto-2); }
  .escuro .d { color: var(--claro-2); }
  .info { font-size: 13px; font-weight: 600; color: var(--cobre-escuro); }
</style>
