---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsFlutuante from '../components/WhatsFlutuante.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  atual?: string;
  schema?: Record<string, unknown>[];
}
const { title, description, atual, schema = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);

const negocio = {
  '@context': 'https://schema.org',
  '@type': 'MedicalBusiness',
  name: site.nome,
  description: site.especialidade,
  telephone: '+' + site.whatsapp,
  areaServed: site.regiao,
  sameAs: [site.instagram],
  url: Astro.site?.toString(),
};
---
<!doctype html>
<html lang="pt-BR" class="no-js">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <meta name="theme-color" content="#2A140D" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Montserrat:wght@400;500;600&family=Pinyon+Script&display=swap" rel="stylesheet" />
  <script is:inline>document.documentElement.classList.remove('no-js');</script>
  {[negocio, ...schema].map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body>
  <a class="pular" href="#conteudo">Pular para o conteúdo</a>
  <Header atual={atual} />
  <main id="conteudo">
    <slot />
  </main>
  <Footer />
  <WhatsFlutuante />

  <script>
    // Revela elementos ao rolar
    const io = new IntersectionObserver((entradas) => {
      for (const e of entradas) {
        if (e.isIntersecting) { e.target.classList.add('visivel'); io.unobserve(e.target); }
      }
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  </script>
</body>
</html>

<style>
  .pular { position: absolute; left: 16px; top: -60px; z-index: 100; background: var(--cartao); padding: 10px 16px; border-radius: 8px; }
  .pular:focus { top: 12px; }
</style>
