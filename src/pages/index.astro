---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Passos from '../components/Passos.astro';
import IconeWhats from '../components/IconeWhats.astro';
import fundo from '../assets/fundo.jpg';
import foto from '../assets/dra-vivian.png';
import sobreAtendimento from '../assets/sobre-atendimento.webp';
import monograma from '../assets/monograma.png';
import { site, wa, faqHome, sinaisCapilares } from '../data/site';
import FotoIlustrativa from '../components/FotoIlustrativa.astro';
import { fotoDoTratamento, fotos } from '../data/fotos';
import sala from '../assets/sala.webp';
import recepcao from '../assets/recepcao.webp';
import equipamentos from '../assets/equipamentos.webp';
import { tratamentos } from '../data/tratamentos';

const tituloHero = 'Harmonização facial e saúde capilar, com estratégia para cada rosto';
const palavrasHero = tituloHero.split(' ');
const entradaTexto = 420 + palavrasHero.length * 55;

const areas = [
  {
    tag: 'Rosto', titulo: 'Harmonização facial e estética regenerativa',
    texto: 'Planejamento do rosto com equilíbrio e naturalidade. É sobre realçar, não transformar.',
    foto: fotos.Rosto,
    itens: ['full-face', 'toxina-botulinica', 'preenchimento-labial', 'bioestimuladores'],
  },
  {
    tag: 'Cabelo', titulo: 'Tricologia clínica integrativa',
    texto: 'Saúde capilar de dentro para fora: o cuidado dos fios começa pela causa da queda.',
    foto: fotos.Cabelo,
    itens: ['tricologia-integrativa', 'microagulhamento-capilar', 'regeneracao-personalizada'],
  },
];
const nomeDe = (slug: string) => tratamentos.find((t) => t.slug === slug)!.nome;

const passos = [
  { t: 'Contato', d: 'Você chama no WhatsApp e agenda o melhor horário.' },
  { t: 'Avaliação', d: 'Conversa sobre seus objetivos, histórico e análise do rosto ou do couro cabeludo.' },
  { t: 'Plano personalizado', d: 'Indicação das técnicas e produtos adequados, com explicação de cada etapa.', info: 'Valores apresentados na avaliação' },
  { t: 'Acompanhamento', d: 'Retornos para avaliar a evolução e ajustar o cuidado.' },
];

const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqHome.filter((f) => !f.a.startsWith('[')).map((f) => ({
    '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base
  title="Dra. Vivian Kiss · Harmonização facial e tricologia no ABC Paulista"
  description="Harmonização facial, estética avançada e tricologia clínica integrativa com a Dra. Vivian Caravaggi Kiss. Protocolos seguros e planejamento para cada rosto."
  schema={[faqSchema]}
>
  <!-- HERO -->
  <section id="inicio" class="hero bg-escuro">
    <Image src={fundo} alt="" class="hero-bg" widths={[800, 1600, 2400]} sizes="100vw" loading="eager" />
    <div class="wrap-lg hero-grade">
      <div class="hero-texto">
        <div class="hero-script entra">
          <span class="script">{site.slogan}</span>
          <span class="traco" aria-hidden="true"></span>
        </div>
        <h1 class="hero-h1" aria-label={tituloHero}>
          {palavrasHero.map((palavra, i) => (
            <Fragment>
              <span class="hero-palavra" style={`--atraso:${140 + i * 55}ms`}>
                <span class="hero-palavra-texto">{palavra === 'estratégia' ? <em>{palavra}</em> : palavra}</span>
              </span>{i < palavrasHero.length - 1 && ' '}
            </Fragment>
          ))}
        </h1>
        <p class="hero-p entra" style={`--atraso:${entradaTexto}ms`}>Dra. Vivian Caravaggi Kiss. Uno harmonização facial, estética avançada e tricologia clínica integrativa para realçar a sua melhor versão, com protocolos seguros e base científica.</p>
        <ul class="selos entra" style={`--atraso:${entradaTexto + 100}ms`}>
          <li><svg width="26" height="26" viewBox="0 0 48 48" fill="none" stroke="#E3A585" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="24" cy="24" r="16"></circle><path d="M18 21h1M29 21h1M18 30c3 3 9 3 12 0"></path></svg>Full face</li>
          <li><svg width="28" height="28" viewBox="0 0 48 48" fill="none" stroke="#E3A585" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M24 36c-4-4-6-9-6-14 0-4 2-8 6-11 4 3 6 7 6 11 0 5-2 10-6 14z"></path><path d="M24 36c-5-1-10-4-13-9 2-3 5-4 9-4"></path><path d="M24 36c5-1 10-4 13-9-2-3-5-4-9-4"></path></svg>Estética avançada</li>
          <li><svg width="26" height="26" viewBox="0 0 48 48" fill="none" stroke="#E3A585" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M16 42c-2-8-2-18 2-26 3-6 8-9 14-8"></path><path d="M22 42c-1-7 0-14 3-20 2-4 6-7 10-7"></path></svg>Saúde capilar</li>
        </ul>
        <div class="hero-acoes entra" style={`--atraso:${entradaTexto + 200}ms`}>
          <a class="btn btn-ouro btn-lg" href={wa()} target="_blank" rel="noopener"><IconeWhats size={24} /> Agendar avaliação</a>
          <a class="btn btn-linha btn-lg" href="#tratamentos">Conhecer os tratamentos</a>
        </div>
      </div>
      <div class="hero-foto">
        <div class="arco" data-parallax>
          <video src="/hero.mp4" autoplay muted loop playsinline preload="auto" aria-label="Dra. Vivian Caravaggi Kiss em vídeo"></video>
        </div>
        <div class="selo-nome">
          <svg width="40" height="40" viewBox="0 0 48 48" fill="none" stroke="#E3A585" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M24 36c-4-4-6-9-6-14 0-4 2-8 6-11 4 3 6 7 6 11 0 5-2 10-6 14z"></path><path d="M24 36c-5-1-10-4-13-9 2-3 5-4 9-4"></path><path d="M24 36c5-1 10-4 13-9-2-3-5-4-9-4"></path><path d="M10 40h28"></path></svg>
          <span class="divisor" aria-hidden="true"></span>
          <span><span class="sn1">Dra. Vivian C. Kiss</span><span class="sn2">Tricologia &amp; Harmonização Facial</span></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ÁREAS -->
  <section id="areas" class="sec bg-creme">
    <div class="wrap">
      <div class="cab-split">
        <h2 class="h2 reveal">Duas frentes que <em>conversam</em> entre si</h2>
        <p class="lead reveal" style="--d:100ms">Rosto e cabelo são avaliados com o mesmo olhar: entender a causa antes de indicar o tratamento.</p>
      </div>
      <div class="areas">
        {areas.map((a, i) => (
          <article class="area reveal" style={`--d:${i * 120}ms`}>
            <FotoIlustrativa foto={a.foto} altura="320px" sizes="(max-width: 760px) 100vw, 50vw" />
            <div class="area-corpo">
              <span class="tag">{a.tag}</span>
              <h3>{a.titulo}</h3>
              <p class="lead">{a.texto}</p>
              <ul>
                {a.itens.map((s) => <li><a href={`/tratamentos/${s}`}><span>{nomeDe(s)}</span><span aria-hidden="true">→</span></a></li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- TRATAMENTOS -->
  <section id="tratamentos" class="sec bg-creme-2">
    <div class="wrap">
      <div class="trat-cab">
        <h2 class="h2 reveal">Tratamentos</h2>
        <div role="group" aria-label="Filtrar tratamentos" class="filtros reveal" data-filtros>
          {['Todos', 'Rosto', 'Pele', 'Cabelo'].map((f, i) => (
            <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-filtro={f}>{f}</button>
          ))}
        </div>
      </div>
      <div class="trat-grade reveal">
        <div class="trat-lista" data-lista>
          {tratamentos.map((t, i) => (
            <button type="button" class="trat-item" aria-pressed={i === 0 ? 'true' : 'false'} aria-controls="painel-trat" data-item={t.slug} data-grupo={t.grupo}>
              <span class="trat-topo">
                <span class="trat-grupo">{t.grupo}</span>
                <span class="trat-seta" aria-hidden="true">→</span>
              </span>
              <span class="trat-nome">{t.nome}</span>
              <span class="trat-resumo">{t.resumo}</span>
            </button>
          ))}
        </div>
        <aside id="painel-trat" class="painel" aria-live="polite">
          {tratamentos.map((t, i) => (
            <div class="painel-item" data-painel={t.slug} hidden={i !== 0}>
              <FotoIlustrativa foto={fotoDoTratamento(t)} altura="220px" sizes="(max-width: 760px) 100vw, 50vw" />
              <div class="painel-corpo">
                <span class="pill">{t.area}</span>
                <h3>{t.nome}</h3>
                <p class="lead">{t.resumo}</p>
                <dl class="fatos">
                  <div><dt>Duração</dt><dd>{t.duracao}</dd></div>
                  <div><dt>Recuperação</dt><dd>{t.recuperacao}</dd></div>
                </dl>
                <p class="quem"><strong>Para quem é:</strong> <span>{t.paraQuem}</span></p>
                <div class="painel-acoes">
                  <a class="btn btn-cobre" href={wa(`Olá, Dra. Vivian! Vim pelo site e gostaria de saber mais sobre ${t.nome.toLowerCase()}.`)} target="_blank" rel="noopener">Agendar avaliação</a>
                  <a class="saiba" href={`/tratamentos/${t.slug}`}>Saiba mais →</a>
                </div>
                <p class="nota">Indicação, técnica e quantidade são definidas somente após avaliação individual.</p>
              </div>
            </div>
          ))}
        </aside>
      </div>
    </div>
  </section>

  <!-- TRICOLOGIA -->
  <section id="tricologia" class="sec bg-escuro">
    <div class="wrap tri">
      <div class="tri-texto">
        <p class="script reveal" style="color: var(--cobre-claro)">Tricologia clínica integrativa</p>
        <h2 class="h2 reveal">Seu cabelo está dando <em>sinais?</em></h2>
        <p class="lead reveal" style="margin: 28px 0 32px; max-width: 520px">Queda e fios finos raramente têm uma causa só. A consulta avalia couro cabeludo, fios, hábitos e fatores internos para tratar a origem, e não só o sintoma.</p>
        <div class="reveal" style="display:flex; flex-wrap:wrap; gap:16px">
          <a class="btn btn-ouro" href="/tricologia#sinais">Fazer o autoteste</a>
          <a class="btn btn-linha" href="/tricologia">Conhecer a tricologia</a>
        </div>
      </div>
      <ul class="sinais">
        {sinaisCapilares.slice(0, 6).map((s, i) => (
          <li class="reveal" style={`--d:${i * 70}ms`}>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#E3A585" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M7.5 12.5l3 3 6-6.5"></path></svg>{s}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- SOBRE -->
  <section id="sobre" class="sec bg-creme">
    <div class="wrap sobre">
      <div class="sobre-foto reveal">
        <FotoIlustrativa foto={{ src: sobreAtendimento, alt: 'Caderno aberto e caneta sobre uma mesa' }} altura="clamp(440px, 50vw, 640px)" sizes="(max-width: 760px) 90vw, 50vw" />
      </div>
      <div class="sobre-texto">
        <h2 class="h2 reveal">Prazer, <em>Vivian</em></h2>
        <p class="lead reveal" style="margin-top: 24px">Dra. Vivian Caravaggi Kiss atua em harmonização facial, estética regenerativa e tricologia clínica integrativa. Seu propósito é embelezar com naturalidade e devolver autoestima, sempre com atualização constante em segurança e técnica.</p>
      </div>
    </div>
  </section>

  <!-- CONSULTÓRIO -->
  <section aria-labelledby="consultorio-t" class="sec bg-creme-2">
    <div class="wrap">
      <h2 id="consultorio-t" class="h2 reveal" style="margin-bottom: 32px">Ambientes e equipamentos <em>de atendimento</em></h2>
      <div class="galeria reveal">
        <FotoIlustrativa foto={{ src: sala, alt: 'Sala com cadeira de atendimento' }} altura="250px" sizes="(max-width: 620px) 100vw, 33vw" />
        <FotoIlustrativa foto={{ src: recepcao, alt: 'Recepção com poltronas em terracota' }} altura="250px" sizes="(max-width: 620px) 100vw, 33vw" />
        <FotoIlustrativa foto={{ src: equipamentos, alt: 'Equipamento de avaliação capilar sobre bancada' }} altura="250px" sizes="(max-width: 620px) 100vw, 33vw" />
      </div>
    </div>
  </section>

  <!-- COMO FUNCIONA -->
  <section id="atendimento" class="sec bg-creme">
    <div class="wrap">
      <h2 class="h2 reveal" style="margin-bottom: 56px; max-width: 760px">Do primeiro contato ao <em>acompanhamento</em></h2>
      <Passos itens={passos} />
    </div>
  </section>

  <!-- FAQ -->
  <section id="duvidas" class="sec bg-creme-2">
    <div class="wrap duvidas">
      <div class="duv-cab">
        <h2 class="h2 reveal">Perguntas <em>frequentes</em></h2>
        <p class="lead reveal" style="margin-top: 24px">Não achou sua dúvida? <a href={wa()} target="_blank" rel="noopener">Pergunte pelo WhatsApp</a>.</p>
      </div>
      <div class="duv-lista reveal"><Faq itens={faqHome} /></div>
    </div>
  </section>

  <!-- CONTATO -->
  <section id="contato" class="sec bg-escuro contato">
    <Image src={fundo} alt="" class="contato-bg" widths={[800, 1600]} sizes="100vw" />
    <div class="wrap contato-grade">
      <div class="contato-texto">
        <Image src={monograma} alt="" width={176} class="contato-mono reveal" />
        <p class="script reveal" style="color: var(--cobre-claro)">{site.slogan}</p>
        <h2 class="h2 reveal">Agende a sua avaliação</h2>
        <p class="lead reveal" style="margin-top: 22px; max-width: 520px">Atendimento individual e com hora marcada. Mande uma mensagem e conte o que você procura.</p>
        <a class="btn btn-ouro btn-lg reveal" style="margin-top: 32px" href={wa()} target="_blank" rel="noopener"><IconeWhats size={22} /> Falar com a Dra. Vivian</a>
        <dl class="dados">
          <div><dt>WhatsApp</dt><dd><a href={wa()} target="_blank" rel="noopener">{site.whatsappExibicao}</a></dd></div>
          <div><dt>Instagram</dt><dd><a href={site.instagram} target="_blank" rel="noopener">{site.instagramExibicao}</a></dd></div>
        </dl>
      </div>
    </div>
  </section>
</Base>

<script>
  // Filtro e painel de tratamentos
  const filtros = document.querySelectorAll<HTMLButtonElement>('[data-filtro]');
  const itens = document.querySelectorAll<HTMLButtonElement>('[data-item]');
  const paineis = document.querySelectorAll<HTMLElement>('[data-painel]');

  const escolhe = (slug: string) => {
    itens.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.item === slug)));
    paineis.forEach((p) => {
      const ativo = p.dataset.painel === slug;
      p.hidden = !ativo;
      if (ativo) { p.classList.remove('troca'); void p.offsetWidth; p.classList.add('troca'); }
    });
  };
  itens.forEach((b) => b.addEventListener('click', () => escolhe(b.dataset.item!)));
  filtros.forEach((f) => f.addEventListener('click', () => {
    const g = f.dataset.filtro!;
    filtros.forEach((x) => x.setAttribute('aria-pressed', String(x === f)));
    let primeiro: string | undefined;
    itens.forEach((b) => {
      const mostra = g === 'Todos' || b.dataset.grupo === g;
      b.hidden = !mostra;
      if (mostra && !primeiro) primeiro = b.dataset.item;
    });
    if (primeiro) escolhe(primeiro);
  }));

  // Parallax suave na foto do hero
  const arco = document.querySelector<HTMLElement>('[data-parallax]');
  if (arco && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    window.addEventListener('scroll', () => {
      const y = Math.min(window.scrollY, 900);
      arco.style.setProperty('--deslocamento-foto', `${y * 0.08}px`);
    }, { passive: true });
  }
</script>

<style>
  /* Hero (aprovado na v3/v4) */
  .hero { --curva-entrada: cubic-bezier(.2,.75,.15,1); position: relative; overflow: hidden; }
  .hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-grade { position: relative; z-index: 1; padding: 120px var(--gutter) 0; display: flex; flex-wrap: wrap; align-items: flex-end; gap: 40px; }
  .hero-texto { flex: 1 1 560px; min-width: 0; padding-bottom: 96px; }
  .hero-script { display: flex; align-items: center; gap: 28px; margin-bottom: 26px; }
  .hero-script .script { font-size: clamp(32px, 3.4vw, 44px); }
  .traco { flex: 0 1 220px; height: 1px; background: linear-gradient(90deg, #C98B6B, #C98B6B00); }
  .hero-h1 { font-size: clamp(46px, 5.6vw, 76px); line-height: 1.04; letter-spacing: -0.01em; color: var(--claro); }
  .hero-h1 em { color: var(--cobre-claro); }
  .hero-p { margin-top: 26px; max-width: 640px; font-size: clamp(17px, 1.4vw, 19px); color: #F2DCCF; }
  .selos { list-style: none; display: inline-flex; flex-wrap: wrap; align-items: center; gap: 10px 22px; margin: 34px 0 0; padding: 14px 30px; border: 1px solid #8A5A44; border-radius: 999px; font-size: 16px; font-weight: 500; color: var(--claro); }
  .selos li { display: inline-flex; align-items: center; gap: 12px; }
  .selos li + li::before { content: ''; width: 1px; height: 22px; background: #8A5A44; margin-right: 10px; }
  .hero-acoes { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 44px; }
  .hero-foto { flex: 0 1 560px; min-width: 0; position: relative; align-self: stretch; display: flex; justify-content: center; align-items: flex-end; }
  .arco { position: relative; width: 100%; max-width: 560px; height: clamp(460px, 56vw, 800px); border-radius: 280px 280px 0 0; padding: 4px 4px 0; background: linear-gradient(180deg, #F2C3A4 0%, #A0543A 60%, #6E3420 100%); box-shadow: 0 0 60px -10px #C98B6B88; will-change: transform; }
  .arco img, .arco video { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 0%; border-radius: 276px 276px 0 0; background: radial-gradient(ellipse at 50% 30%, #8A4A33 0%, #4A2216 80%); }
  .selo-nome { position: absolute; left: -40px; bottom: 90px; display: flex; align-items: center; gap: 18px; padding: 20px 28px; border-radius: 16px; background: #2A140DE6; border: 1px solid #8A5A44; box-shadow: 0 18px 40px -20px #000; }
  .selo-nome .divisor { width: 1px; height: 44px; background: #8A5A44; }
  .selo-nome > span:last-child { display: flex; flex-direction: column; line-height: 1.3; }
  .sn1 { font-family: var(--serif); font-size: 26px; font-weight: 500; color: var(--claro); }
  .sn2 { font-size: 15px; color: #E3C3B2; }
  .hero-palavra, .hero-palavra-texto { display: inline-block; }
  @media (prefers-reduced-motion: no-preference) {
    .hero-palavra { clip-path: inset(-.12em -.18em -.16em); }
    .hero-palavra-texto { animation: surge-palavra 850ms var(--curva-entrada) var(--atraso) backwards; }
    .entra { animation: sobe 750ms var(--curva-entrada) var(--atraso, 80ms) backwards; }
    .hero-acoes:focus-within { animation: none; }
    .hero-foto { animation: surge-foto 1100ms var(--curva-entrada) 120ms backwards; }
    .selo-nome { animation: sobe 650ms var(--curva-entrada) 590ms backwards; }
  }
  @keyframes surge-palavra { from { transform: translateY(125%); } }
  @keyframes sobe { from { opacity: 0; transform: translateY(16px); } }
  @keyframes surge-foto {
    from { opacity: 0; clip-path: inset(100% -70px -70px); }
    to { opacity: 1; clip-path: inset(-70px -70px -70px); }
  }
  @keyframes flutua { 50% { transform: translateY(-8px); } }
  @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
    .arco { transform: translateY(var(--deslocamento-foto, 0px)); }
    .selo-nome { animation: sobe 650ms var(--curva-entrada) 590ms backwards, flutua 6s ease-in-out 1.6s infinite; }
  }
  @media (max-width: 767px) {
    .hero-grade { display: grid; gap: 28px; padding-top: 104px; }
    .hero-foto { grid-row: 1; width: min(100%, 480px); justify-self: center; }
    .arco { height: clamp(290px, 56svh, 460px); }
    .selo-nome { left: 8px; bottom: 12px; max-width: calc(100% - 16px); gap: 10px; padding: 10px 14px; }
    .selo-nome svg { width: 28px; height: 28px; flex-shrink: 0; }
    .selo-nome .divisor { height: 34px; flex-shrink: 0; }
    .sn1 { font-size: 21px; }
    .sn2 { font-size: 13px; }
    .hero-texto { padding-bottom: 40px; }
    .hero-script { margin-bottom: 14px; }
    .hero-h1 { font-size: clamp(36px, 8vw, 48px); }
    .selos { display: none; }
    .hero-acoes { flex-direction: column; margin-top: 28px; }
    .hero-acoes .btn { width: 100%; text-align: center; }
  }

  /* Credenciais */

  /* Áreas */
  .cab-split { display: flex; flex-wrap: wrap; gap: 24px 80px; align-items: flex-end; margin-bottom: 56px; }
  .cab-split .h2 { flex: 1 1 520px; }
  .cab-split .lead { flex: 1 1 320px; }
  .areas { display: flex; flex-wrap: wrap; gap: 28px; }
  .area { flex: 1 1 480px; min-width: 0; background: var(--cartao); border-radius: 28px; overflow: hidden; display: flex; flex-direction: column; transition: var(--reveal-transition), transform .4s ease, box-shadow .4s ease; }
  .area:hover { transform: translateY(-4px); box-shadow: 0 30px 60px -40px #5A2414; }
  .area-corpo { padding: 40px; display: flex; flex-direction: column; gap: 14px; }
  .tag { font-size: 12px; letter-spacing: .2em; text-transform: uppercase; font-weight: 600; color: var(--cobre); }
  .area h3 { font-size: clamp(32px, 3vw, 40px); line-height: 1.05; }
